alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'


alias k='kubectl'
alias kg='kubectl get'
alias kd='kubectl describe'
alias kdel='kubectl delete'
alias kl='kubectl logs -f'
alias kgp='kubectl get pods'
alias kgs='kubectl get services'
alias kgd='kubectl get deployments'
alias kns='kubectl config set-context --current --namespace'
alias kctx='kubectl config use-context'


alias gst='git status -sb'
alias glog='git log --oneline --graph --decorate --all'
alias gcom='git checkout main || git checkout master'
alias gcod='git checkout develop'
alias gpo='git push origin'
alias gpom='git push origin main || git push origin master'
alias grh='git reset --hard'
alias grs='git reset --soft'
alias gcane='git commit --amend --no-edit'
alias gwip='git add -A && git commit -m "WIP"'
alias gunwip='git log -n 1 | grep -q -c "WIP" && git reset HEAD~1'


alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
alias dpsa='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
alias dimg='docker images --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"'
alias dstop='docker stop $(docker ps -q)'
alias dclean='docker system prune -f'
alias dlog='docker logs -f'
alias dexec='docker exec -it'
alias drnit='docker run -it --rm '

alias sn='nix develop --extra-experimental-features "nix-command flakes"'


alias ydev='yarn dev'
alias ybuild='yarn build'
alias yba='yarn build:affected --base=main --head=HEAD'
alias ystart='yarn start'
alias yclean='yarn clean'
alias ygraph='yarn graph'
alias ytc='yarn typecheck'


alias nxps='yarn nx show projects'
alias nxpa='yarn nx show project'
alias nxg='yarn nx graph'
alias nxga='yarn nx affected --graph'
alias nxda='yarn nx affected --target=build --dry-run'
alias nxba='yarn nx affected --target=build --base=main --head=HEAD'
alias nxbad='yarn build:affected'

alias phpgensw='php artisan l5-swagger:generate'

alias phptree='tree -I "vendor|node_modules|storage|bootstrap/cache|public/build|.git|coverage|.idea|.vscode"'
alias phprn='php artisan serve'

alias mfr='php artisan make:filament-resource'
alias mm='php artisan make:model'
alias mmm='php artisan make:model -mfs'   # модель + миграция + фабрика + сидер
alias mc='php artisan make:controller'
alias mcr='php artisan make:controller --resource'
alias mreq='php artisan make:request'
alias mmig='php artisan make:migration'
alias mseed='php artisan make:seeder'
alias mfact='php artisan make:factory'
alias mjob='php artisan make:job'
alias mevent='php artisan make:event'
alias mlisten='php artisan make:listener'
alias mmw='php artisan make:middleware'
alias mpol='php artisan make:policy'
alias mnotif='php artisan make:notification'
alias mtest='php artisan make:test'

alias phpmig='php artisan migrate'
alias phpmigf='php artisan migrate:fresh'
alias phpmigfs='php artisan migrate:fresh --seed'
alias phpmigr='php artisan migrate:rollback'
alias phpseed='php artisan db:seed'

alias phpcc='php artisan config:clear'
alias phpcache='php artisan optimize:clear'
alias phpopt='php artisan optimize'
alias phproute='php artisan route:list'

alias cu='composer update'
alias ci='composer install'
alias cda='composer dump-autoload'
alias creq='composer require'

alias mfp='php artisan make:filament-page'
alias mfw='php artisan make:filament-widget'
alias mfrel='php artisan make:filament-relation-manager'

alias pint='./vendor/bin/pint'
alias pintt='./vendor/bin/pint --test'

# PHP-CS-Fixer
alias csfix='./vendor/bin/php-cs-fixer fix app/ --rules=no_unused_imports'
alias cscheck='./vendor/bin/php-cs-fixer fix app/ --rules=no_unused_imports --dry-run --diff'
